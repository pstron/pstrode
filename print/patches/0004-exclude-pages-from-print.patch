 const INFO = "\x1b[1;32m[INFO]\x1b[0m "
 const ERROR = "\x1b[1;31m[ERROR]\x1b[0m "
 
+// pstrode: pages that are exported to the website but must not end up in the
+// printed book.  Set PSTRODE_EXPORT_EXCLUDE to a comma separated list of
+// paths relative to docs/; a trailing slash excludes a whole directory, e.g.
+// "index.md,intro/".
+const EXCLUDED_PAGES = (process.env.PSTRODE_EXPORT_EXCLUDE || '')
+  .split(',')
+  .map(page => page.trim())
+  .filter(page => page !== '')
+
+function isExcluded(page) {
+  return EXCLUDED_PAGES.some(excluded => excluded.endsWith('/')
+    ? page.startsWith(excluded)
+    : page === excluded)
+}
+
+// Drop excluded pages from the navigation before anything else.  Doing this
+// on the catalog (instead of only skipping the conversion) also drops the
+// chapters that become empty and renumbers the remaining ones.
+function pruneCatalog(node) {
+  if (typeof node === 'string') {
+    return isExcluded(node) ? undefined : node
+  }
+  if (node instanceof Array) {
+    const kept = node.map(pruneCatalog).filter(child => child !== undefined)
+    return kept.length > 0 ? kept : undefined
+  }
+  if (node instanceof Object) {
+    const kept = {}
+    for (const key of Object.keys(node)) {
+      const child = pruneCatalog(node[key])
+      if (child !== undefined) {
+        kept[key] = child
+      }
+    }
+    return Object.keys(kept).length > 0 ? kept : undefined
+  }
+  return node
+}
